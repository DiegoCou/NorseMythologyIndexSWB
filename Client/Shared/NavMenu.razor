@using System.Globalization
@using System.Text
@using BlazorBasic.Pages
@using MudBlazor
@using NorseMythologyIndex.Models
@using NorseMythologyIndex.Services
@inject NavigationManager NavigationManager
@inject MythologyService MythologyService

<MudAppBar Fixed="true" Elevation="0" class="d-flex menu-container align-center">
    <div class="menu-inner">
    <MudMenuItem class="nav-item " Href="/" Label="Home"></MudMenuItem>
    <MudMenu class="nav-item">
        <ActivatorContent >
            <MudText Style="color:black">Characters</MudText>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="/mythologyList/aesir" class="nav-link" Label="Æsir"></MudMenuItem>
            <MudMenuItem Href="/mythologyList/vanir" class="nav-link" Label="Vanir"></MudMenuItem>
            <MudMenuItem Href="/mythologyList/jötunn" class="nav-link" Label="Jötunn"></MudMenuItem>
            <MudMenuItem Href="/mythologyList/other" class="nav-link" Label="Other Beings"></MudMenuItem>
        </ChildContent>
    </MudMenu>
    <MudMenuItem class="nav-item " Href="/mythologyList/object" Label="Objects"></MudMenuItem>
    <MudMenuItem class="nav-item " Href="/mythologyList/location" Label="Locations"></MudMenuItem>
    <MudMenuItem class="nav-item " Href="/mythologyList/aboutus" Label="About Us"></MudMenuItem>
    <div class="nav-item">
        <MudAutocomplete Style="width: 10rem; margin-top: -1rem;" class="search-bar" Dense="true" T="string" MaxItems="100"
                         Label="Search" Variant="Variant.Text" 
                         Value="_searchString" ValueChanged="OnValueChanged" SearchFunc="@Search" Clearable="true">
        </MudAutocomplete>
    </div>
    <MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_theme"/>
    <MudSwitch @bind-Value="_isDarkMode" Color="Color.Primary" Class="ma-4" T="bool"
               ThumbIcon="@(_isDarkMode==true ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
               />
    </div>
</MudAppBar>

@code{

    private Dictionary<string, MythologyItem> _mythologyItems = new();
    private bool _isLoading = true;
    private string _searchString = string.Empty;
    
    protected override async Task OnInitializedAsync()
    {
        _mythologyItems = await MythologyService.GetAllItemsAsync();
        _isLoading = false;
    }
    private void OnValueChanged(string value)
    {
        _searchString = value;
        NavigationManager.NavigateTo($"/item/{_searchString}");
    }

    private async Task<IEnumerable<string>> Search(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
        {
            return _mythologyItems.Keys.Where(x => MythologyService.RemoveSpecialCharacters(x).Contains(""));
        }

        return _mythologyItems.Keys.Where(x => MythologyService.RemoveSpecialCharacters(x).Contains(value, StringComparison.CurrentCultureIgnoreCase));
    }
    
    
    private MudTheme _theme = new();
    private bool _isDarkMode;
        
    private MudThemeProvider _mudThemeProvider;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    
}

<style>
    .menu-container{
        background-color: #E6E6E6;
        height: 4rem;
        /* Override MudBlazor's flex on the AppBar */
        display: block !important;
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        padding: 0;
    }
    .search-bar {
        --mud-palette-lines-inputs: darkgrey !important;
    }
    .search-bar .mud-input-label{
        color: darkgray !important;
    }
    
    .search-bar .mud-input-slot{
        color: black !important;
    }
    
    .menu-inner{
        display: inline-flex;    /* inline-flex instead of flex */
        align-items: center;
        justify-content: center;
        min-width: 100%;         /* at least fill the bar */
        height: 4rem;
        
    }
    /* On small screens, start from the left so scroll works correctly */
    @@media (max-width: 960px) {
        .menu-inner {
            justify-content: start;
            min-width: max-content;
        }
    }
    .nav-item{
        margin: auto 1rem;
        width: fit-content;
        color: black;
    }
    .nav-item:hover{
        background-color: transparent;
    }
    .nav-link{
        margin-top: 0.5rem;
        text-decoration: none;
        font-size: 1.1rem;
    }
    .nav-link:hover{
        background-color: transparent;
    }
    
</style>