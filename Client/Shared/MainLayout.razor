@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div  class="page">
    <MudLayout Style="height: 100vh; overflow: hidden; display: flex; flex-direction: column;">        
        <NavMenu/>

        <main style="margin-top: 0rem" >
                @Body
        </main>
    </MudLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



