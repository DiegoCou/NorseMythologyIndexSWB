
@page "/jotunn"
@using System.Reflection.Metadata
@using MudBlazor
@using NorseMythologyIndex.Models
@using NorseMythologyIndex.Services
@inject MythologyService MythologyService
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager

<PageTitle>Jötunn</PageTitle>
<MudMainContent Style="overflow-y: auto; height:100vh; width: 100%" class="page-container">
    <MudText Align="Align.Center" Typo="Typo.h4">Jötnar</MudText>
    @if (isLoading)
    {
        <div class="loading">
            <p>Loading Jötunn...</p>
        </div>
    }
    else if (jotunItems.Any())
    {
        @foreach (var group in MythologyService.GetGroupedItems(jotunItems))
        {
            <MudText Typo="Typo.h6">@group.Key</MudText>
            <MudDivider Style="margin-bottom: 0.7rem; border-color: black" ></MudDivider>
            <MudStack Style="margin-bottom: 1rem" Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var item in group)
                {
                    <tr style="width: auto;">
                        <td>
                            <NavLink class="item --mud-palette-text-primary" href="@($"/item/{item.Key}")">@item.Key</NavLink>
                        </td>
                    </tr>
                    <td style="margin: 0 1rem; width: auto;">
                        ·
                    </td>
                }
            </MudStack>
        }
    }
    else
    {
        <p>No Æsir Items found.</p>
    }
</MudMainContent>

@code {
    private Dictionary<string, MythologyItem> jotunItems = new();
    private bool isLoading = true;
    private string? selectedItemName;

    
    protected override async Task OnInitializedAsync()
    {
        jotunItems = await MythologyService.GetItemsByTypeAsync("Jötunn");
        isLoading = false;
    }

}

<style>
    .page-container {
        margin: 0 auto;
        padding: 6rem 30ch;
        height: fit-content;
    }
    @@media (max-width: 960px) {
        .page-container {
            padding: 6rem 1rem;
        }
    }
    h1 {
        color: #2c3e50;
        margin-bottom: 2rem;
        font-size: 2.5rem;
        text-align: center;
    }

    .item {
        margin: 0;
        padding: 0;
        text-decoration: none;
    }
    .loading {
        text-align: center;
        padding: 3rem;
        font-size: 1.2rem;
        color: #666;
    }
</style>


