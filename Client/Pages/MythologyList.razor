@page "/mythologyList/{selectedListName}"
@using System.Reflection.Metadata
@using MudBlazor
@using NorseMythologyIndex.Models
@using NorseMythologyIndex.Services
@inject MythologyService MythologyService
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager

<PageTitle>Æsir</PageTitle>
<MudMainContent Style="overflow-y: auto; height:100vh; width: 100%" class="page-container">
    <MudText Align="Align.Center" Typo="Typo.h4">@GetTitle(SelectedListName)</MudText>
    
    @if (_isLoading)
    {
        <div class="loading">
            <p>Loading @GetTitle(SelectedListName)...</p>
        </div>
    }
    else if (_mythologyItems.Any())
    {
        <MudStack AlignItems="AlignItems.Stretch" Row="true" Wrap="Wrap.Wrap" Spacing="2" Style="margin-bottom: 1rem;">
            @foreach(var tag in TagDictionary.Keys)
            {
                <MudCheckBox @bind-value="TagDictionary[tag]" Label="@tag"  ></MudCheckBox>
            }
        </MudStack>
        @foreach (var group in MythologyService.GetGroupedItems(FilteredItems))
            {
                <MudText Typo="Typo.h6">@group.Key</MudText>
                <MudDivider Style="margin-bottom: 0.7rem; border-color: black" ></MudDivider>
                <MudStack Style="margin-bottom: 1rem" Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    
                    @foreach (var item in group)
                    {

                        <div style="display:flex; align-items:center;">
                            <NavLink class="item --mud-palette-text-primary" href="@($"/item/{item.Key}")">@item.Key</NavLink>
                            <span style="margin: 0 1rem;">·</span>
                        </div>
                    }
                </MudStack>
            }
    }
    else
    {
        <p>No Æsir Items found.</p>
    }
</MudMainContent>

@code {
    private Dictionary<string, MythologyItem> _mythologyItems = new();   
    private bool _isLoading = true;
    public Dictionary<string, bool> TagDictionary = new();
    [Parameter] public string? SelectedListName { get; set; }

    protected string GetTitle(string name)
    {
        return name switch
        {
            "aesir" => "Æsir",
            "vanir" => "Vanir",
            "jötunn" => "Jötunn",
            "other" => "Other Beings",
            "object" => "Objects",
            "location" => "Locations",
            _ => name
        };
    }

    private Dictionary<string, MythologyItem> FilteredItems
    {
        get
        {
            var checkedTags = TagDictionary
                .Where(kvp => kvp.Value)
                .Select(kvp => kvp.Key)
                .ToHashSet();

            if (checkedTags.Count == 0)
                return _mythologyItems;

            return _mythologyItems
                .Where(kvp => checkedTags.All(t => kvp.Value.Tags.Contains(t)))
                .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        if (SelectedListName != null)
        {
            _mythologyItems = await MythologyService.GetItemsByTypeAsync(SelectedListName);
            foreach (var tag in MythologyService.GetTagList(_mythologyItems, SelectedListName))
            {
                TagDictionary[tag] = false;
            }
        }

        _isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedListName != null)
        {
            TagDictionary.Clear();
            _mythologyItems = await MythologyService.GetItemsByTypeAsync(SelectedListName);
            foreach (var tag in MythologyService.GetTagList(_mythologyItems, SelectedListName))
            {
                TagDictionary[tag] = false;
            }
        }

        _isLoading = false;    
        
    }

}

<style>
    .page-container {
        margin: 0 auto;
        padding: 6rem 30ch;
        height: fit-content;
    }
    @@media (max-width: 960px) {
        .page-container {
            padding: 6rem 1rem;
        }
    }
    h1 {
        color: #2c3e50;
        margin-bottom: 2rem;
        font-size: 2.5rem;
        text-align: center;
    }
    .item {
        margin: 0;
        padding: 0;
        text-decoration: none;
    }
    .loading {
        text-align: center;
        padding: 3rem;
        font-size: 1.2rem;
        color: #666;
    }
</style>