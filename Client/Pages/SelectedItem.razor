@page "/item/{selectedItemName}"
@using System.ComponentModel.Design
@using System.Reflection.Metadata.Ecma335
@using System.Text.RegularExpressions
@using MudBlazor
@using NorseMythologyIndex.Models
@using NorseMythologyIndex.Services
@inject MythologyService MythologyService
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@inject IScrollManager ScrollManager

<PageTitle>@selectedItemName</PageTitle>
<MudLayout Style="margin-top: 3.4rem; padding: 0;" >
@if (isLoading)
{
    <div class="loading">
        <p>Loading Æsir...</p>
    </div>
}
else if (selectedItem is not null)
{
   
    <MudStack Style="margin: 0; padding: 0;" Row="true" Wrap="Wrap.NoWrap" Spacing="0">
        <!-- Sidebar with navigation -->
        <MudContainer Fixed="true" Style="margin: 0; padding: 1rem 0rem 0 1rem; width: fit-content; height:100vh; flex-shrink: 0; background-color: #e6e6e6">
            <MudList T="string">
                <ChildContent>
                    @{
                        var tabs = selectedItem.Attestations.Keys.ToList();
                        var currentTab = _activePanelIndex >= 0 && _activePanelIndex < tabs.Count ? tabs[_activePanelIndex] : string.Empty;
                    }
                    @if (selectedItem.Attestations.TryGetValue(currentTab, out var selectedAttestation))
                    {
                        <button style="text-align: left" onclick="scrollToElement('@RemoveSpecialCharacters(@currentTab)')">@currentTab</button>
                        <MudList T="string">
                            <ChildContent>
                                <MudStack Style="margin: 0 5rem 0 0; padding: 0" Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Spacing="0">
                                    @foreach (var reference in selectedAttestation.GetReferences())
                                    {
                                        <button style="margin-left: 1rem; text-align: left" onmousedown="event.preventDefault()" onclick="scrollToElement('@RemoveSpecialCharacters(@reference.Key)')">· @MythologyService.GetReferenceWithoutTranslation(reference.Key)</button>

                                    }
                                </MudStack>
                            </ChildContent>
                        </MudList>
                    }
                </ChildContent>
            </MudList>
        </MudContainer>
        <!-- Main content area -->
        <MudMainContent id="main-content" Style="margin: 0; padding: 1rem 0rem 0 1rem;flex-grow: 1; overflow-y: auto; height:90vh">
            <MudScrollToTop>
                <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowCircleUp"/>
            </MudScrollToTop>
            <!-- Name of the Selected Item -->
            <MudStack class="d-flex justify-left align-left mud-height-full">
                <MudText class="selected-item-name">@selectedItemName</MudText>
                <MudStack Wrap="Wrap.NoWrap" Spacing="1" Row="true">
                    @for (int index = 0; index < @selectedItem.Tags.Count; index++)
                    {
                        var index1 = index;
                        <MudText Style="width: fit-content; font-size: 0.8rem">@selectedItem.Tags[index1]</MudText>
                        if (index1 < @selectedItem.Tags.Count - 1)
                        {
                            <MudText Style="width: fit-content; font-size: 1rem">·</MudText>
                        }

                    }
                </MudStack>
                <MudTabs @bind-ActivePanelIndex="_activePanelIndex">
                    @foreach (var attestation in selectedItem.Attestations)
                    {
                        <MudTabPanel Style="width: auto; text-transform: none;" Text="@attestation.Key" ID="@attestation.Key">
                            <ChildContent>
                                <!-- Name of the main source (Prose Edda/ Poetic Edda) -->
                                <MudList T="string">
                                    @foreach (var reference in attestation.Value.GetReferences())
                                    {
                                        <MudListItem id="@RemoveSpecialCharacters(reference.Key)" Class="reference-item" Expanded>
                                            <ChildContent>
                                                <!-- Name of Book/Poem -->
                                                <MudText style="font-size: 0.9rem; font-weight: bold; text-decoration: underline;"> <a style="text-decoration: underline; color: @ReturnColorIfLink(reference.Value.Link)" href="@reference.Value.Link" target="_blank">@reference.Key</a>
                                                </MudText>
                                            </ChildContent>
                                            <NestedList >
                                                @foreach (var content in reference.Value.GetContents())
                                                {
                                                    <!-- Stanza or chapter -->
                                                    <MudContainer class="align-left justify-content-left align-content-left" Style="margin: 0; padding: 0 2rem" Text="@(content.Key + ": " + content.Value.Explanation)">
                                                        <ChildContent>
                                                            <a style="font-weight: bold; text-decoration: underline; color: @ReturnColorIfLink(content.Value.Link)" target="_blank" href="@content.Value.Link">@content.Key:</a>
                                                            <span>@content.Value.Explanation</span>
                                                            @if (!string.IsNullOrEmpty(content.Value.Text))
                                                            {
                                                                <p style="white-space: pre-line; margin: 1rem 0; background-color: #f8f9fa; border-radius: 1rem; padding: 1.5rem">@content.Value.Text</p>
                                                            }
                                                        </ChildContent>
                                                    </MudContainer>
                                                }
                                            </NestedList>
                                        </MudListItem>
                                    }
                                </MudList>
                            </ChildContent>
                        </MudTabPanel>
                    }
                </MudTabs>

            </MudStack>
        </MudMainContent>
    </MudStack>
        
}
</MudLayout>

@code{

    private MythologyItem selectedItem
    {
        get
        {
            if (_mythologyItems.Any())
            {
                return _mythologyItems[selectedItemName];
            }

            return null;
        }
        set
        {
            
        }
    }

    [Parameter] public string selectedItemName { get; set; }
    private Dictionary<string, MythologyItem> _mythologyItems = new();
    public bool isLoading = true;
    private int _activePanelIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        _mythologyItems = await MythologyService.GetAllItemsAsync();
        isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_mythologyItems.Any())
        {
            _activePanelIndex = 0;
        }
    }

    public void ScrollToId(string id)
    {
        ScrollManager.ScrollToAsync(id, 1,1,ScrollBehavior.Auto);
    }
    
    public string RemoveSpecialCharacters(string str)
    {
        return Regex.Replace(str, "[^a-zA-Z0-9_.]+", "", RegexOptions.Compiled);
    }

    public string ReturnColorIfLink(string? link)
    {
        if(link == null)
        {
            return "black";
        }
        return link.Length > 0 ? "slateBlue" : "black";
    }
}

<script>
    function scrollToElement(elementId) {
        const mainContent = document.getElementById('main-content');
        const targetElement = document.getElementById(elementId);
        
        if (mainContent && targetElement) {
            const offsetTop = targetElement.offsetTop - mainContent.offsetTop;
            mainContent.scrollTo({
                top: offsetTop,
                behavior: 'smooth'
            });
        }
    }
</script>

<style>
    
    .page-container {
        max-width: 70rem;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
    }
    
    .reference-item{
        scroll-margin: 4.5rem;
    }
    .attestations-container{
        margin-top: 3rem;
    }
    .selected-item-name{
        width: fit-content;
        font-size: 1.2rem;
        font-weight: bold;
    }

    h1 {
        color: #2c3e50;
        margin-bottom: 2rem;
        font-size: 2.5rem;
    }

    .loading {
        text-align: center;
        padding: 3rem;
        font-size: 1.2rem;
        color: #666;
    }


    .tag {
        background: #3498db;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.8rem;
        margin: 0 0.25rem;

    }

    .Item-detail {
        background: white;
        padding: 3rem;
        border-radius: 8px;
        position: relative;
        margin: auto;
        height: fit-content;
    }
    
    .reference h5 {
        color: #34495e;
        
    }

 
    .quote blockquote {
        border-left: 3px solid #95a5a6;
        padding-left: 1rem;
        margin: 1rem 0;
        font-style: italic;
        color: #555;
    }
    
</style>