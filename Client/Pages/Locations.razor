@page "/locations"
@using System.Reflection.Metadata
@using MudBlazor
@using NorseMythologyIndex.Models
@using NorseMythologyIndex.Services
@inject MythologyService MythologyService
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager

<PageTitle>Æsir</PageTitle>
<div class="page-container">
    <h1 style="margin-bottom: 0.1rem;">Locations</h1>

    @if (isLoading)
    {
        <div class="loading">
            <p>Loading Locations...</p>
        </div>
    }
    else if (locationItems.Any())
    {
        @foreach (var group in MythologyService.GetGroupedItems(locationItems))
        {
            <MudText Typo="Typo.h6">@group.Key</MudText>
            <MudDivider Style="margin-bottom: 0.7rem; border-color: black" ></MudDivider>
            <MudStack Style="margin-bottom: 1rem" Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var item in group)
                {
                    <tr style="width: auto;">
                        <td>
                            <NavLink class="item" href="@($"/item/{item.Key}")">@item.Key</NavLink>
                        </td>
                    </tr>
                    <td style="margin: 0 1rem; width: auto;">
                        ·
                    </td>
                }
            </MudStack>
        }
    }
    else
    {
        <p>No Location Items found.</p>
    }
</div>

@code {
    private Dictionary<string, MythologyItem> locationItems = new();
    private bool isLoading = true;
    private string? selectedItemName;
    
    
    protected override async Task OnInitializedAsync()
    {
        locationItems = await MythologyService.GetItemsByTypeAsync("Location");
        isLoading = false;
    }

}

<style>
    
    .page-container {
        max-width: 70rem;
        margin: 0 auto;
        padding: 6rem;
        height: fit-content;
    }

    h1 {
        color: #2c3e50;
        margin-bottom: 2rem;
        font-size: 2.5rem;
        text-align: center;
    }
    .tables-container{
        margin:auto;
        width: fit-content;
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        grid-gap: 5rem;
    }
    .as-table{
        height: fit-content;
    }
    .item {
        margin: 0;
        padding: 0;
        text-decoration: none;
        color: black;
    }
    .loading {
        text-align: center;
        padding: 3rem;
        font-size: 1.2rem;
        color: #666;
    }
</style>


